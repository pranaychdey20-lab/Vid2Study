# ───────────────────────────────────────────────────────────────
#  Vid2Study: what git must NEVER track
# ───────────────────────────────────────────────────────────────

# 🔐 Secrets and signed-in sessions (the bridge writes these on your machine)
bridge/token.txt
bridge/bridge.log
bridge/gemini-session.json
bridge/*-session.json
bridge/profile/
bridge/profile-*/

# 🧳 Machine-specific files generated by the bridge setup
bridge/com.lecturehelper.bridge.json
bridge/native-host.cmd

# 📦 Downloaded / generated, can be recreated
node_modules/
bridge/node_modules/
bridge/bin/
bridge/tmp/
bridge/errors/

# 🧪 Scratch files
bridge/_e.mjs
*.tmp
*.log

# 🛠 Tool and editor state
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 📄 Exports and notes you made while testing
*.zip
*.pdf
